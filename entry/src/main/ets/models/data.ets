export function provinceOf(e:EntryItem):string{
if(PROVINCES.includes(e.province)){return e.province;}
let fix:string|undefined=PROV_FIX[e.title];
return fix!==undefined?fix:'';
}

export function entriesOfProvince(p:string):EntryItem[]{
let out:EntryItem[]=ENTRIES.filter((e:EntryItem)=>provinceOf(e)===p);

if(p==='河南'){
let s:SiteItem|undefined=SITES.find((item:SiteItem)=>item.label==='北宋东京城遗址');
if(s!==undefined){
out.push({title:s.label,era:s.era,eraFull:s.era,summary:s.summary,loc:s.place,type:'遗址建筑',city:'开封',province:'河南',spec:'',material:'—',museum:'',img:s.img,detail:s.summary,form:'',meaning:'',story:'',related:''});
}
}
return out;
}

