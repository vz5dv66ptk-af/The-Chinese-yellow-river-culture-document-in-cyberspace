export interface TopicItem{name:string;keys:string[]}
export const TOPICS:TopicItem[]=[{name:'治水史',keys:['治水','大禹','水利','灌溉','水渠','堤']},{name:'农耕文明',keys:['农耕','农具','粟','稻','犁','仓廪','纺织']},{name:'青铜铸造',keys:['铸造','铸铜','范铸','青铜']},{name:'石窟艺术',keys:['石窟','造像','摩崖','佛像']},{name:'丝绸之路',keys:['丝绸之路','丝路','骆驼','西域','胡人','三彩']},{name:'城邑变迁',keys:['都城','古城','城址','宫殿','城墙']}];

export function entryByTitle(title:string):EntryItem|undefined{
return ENTRIES.find((e:EntryItem)=>e.title===title);
}

export function topicMatch(e:EntryItem,topic:string):boolean{
if(topic==='青铜铸造'&&e.type==='青铜器'){return true;}
if(topic==='石窟艺术'&&e.type==='石刻造像'){return true;}
let text:string=e.title+e.summary+e.eraFull+e.loc+e.form+e.story;
let t:TopicItem|undefined=TOPICS.find((item:TopicItem)=>item.name===topic);
return t!==undefined&&t.keys.some((k:string)=>text.includes(k));
}

export function realKeyOf(title:string):string{
let r:RealItem|undefined=REAL3D.find((item:RealItem)=>item.title===title);
return r!==undefined?r.key:'';
}
